# Caddyfile untuk Railway (Railpack). Sama dengan template bawaan Railpack untuk SPA,
# ditambah header cache: file hasil build (nama ber-hash) di-cache 1 tahun,
# HTML selalu dicek ulang supaya deploy baru langsung terlihat.
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	# Satu domain utama untuk Google: alihkan domain lain secara permanen ke kediaman.co.
	@altHost host official.kediaman.co www.kediaman.co officialkediamanco-production.up.railway.app
	redir @altHost https://kediaman.co{uri} permanent

	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@static path *.png *.jpg *.jpeg *.webp *.avif *.svg *.ico *.woff2 *.woff
	header @static Cache-Control "public, max-age=2592000"

	# Semua yang lain (HTML/rute SPA) dicek ulang setiap kunjungan.
	header ?Cache-Control "no-cache"

	root * {{.DIST_DIR}}

	file_server {
		hide .git
		hide .env*
	}

	encode {
		gzip
		zstd
	}

	# Rute SPA diarahkan ke index.html, tetapi file /assets/ yang tidak ada tetap 404
	# (supaya index.html tidak ikut ter-cache 1 tahun sebagai file JS/CSS).
	route {
		try_files {path} {path}.html {path}/index.html
		@spa {
			not path /assets/*
			not file
		}
		rewrite @spa /index.html
	}
}
