{
  "appId": "co.kediaman.app",
  "appName": "Kediaman",
  "webDir": "mobile/www",
  "server": {
    "url": "https://kediaman.co/?source=app",
    "androidScheme": "https",
    "cleartext": false,
    "allowNavigation": [
      "kediaman.co",
      "*.kediaman.co"
    ],
    "errorPath": "index.html"
  },
  "backgroundColor": "#17261F",
  "android": {
    "appendUserAgent": "KediamanApp/Android",
    "allowMixedContent": false
  },
  "ios": {
    "appendUserAgent": "KediamanApp/iOS",
    "contentInset": "automatic",
    "limitsNavigationsToAppBoundDomains": false
  }
}
